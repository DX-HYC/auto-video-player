{
  "manifest_version": 3,
  "name": "自动连播助手",
  "version": "1.7.8",
  "description": "自动识别网页中的视频与播放列表：视频暂停自动续播，播放结束自动点击下一个。仅在常见视频/网课平台生效。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "自动连播助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.webtrn.cn/*",
        "*://*.bilibili.com/*",
        "*://*.youku.com/*",
        "*://*.iqiyi.com/*",
        "*://*.v.qq.com/*",
        "*://*.study.163.com/*",
        "*://*.icourse163.org/*",
        "*://*.xuetangx.com/*",
        "*://*.zhihuishu.com/*",
        "*://*.imooc.com/*",
        "*://*.chaoxing.com/*",
        "*://*.open.163.com/*",
        "*://*.ke.qq.com/*",
        "*://*.gaodun.com/*",
        "*://*.gaoxiaobang.com/*",
        "*://*.duobei.com/*",
        "*://*.xuexi.cn/*",
        "*://*.docin.com/*",
        "*://*.doc88.com/*",
        "*://*.youtube.com/*",
        "*://*.vimeo.com/*",
        "*://*.twitch.tv/*",
        "*://*.douyin.com/*",
        "*://*.kuaishou.com/*",
        "*://*.huya.com/*",
        "*://*.douyu.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
